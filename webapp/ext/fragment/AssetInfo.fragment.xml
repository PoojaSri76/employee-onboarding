
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards">

    <VBox width="100%" class="sapUiMediumMargin">

        <f:GridContainer
            width="100%"
            snapToRow="true">

            <f:layout>
                <f:GridContainerSettings
                    rowSize="5rem"
                    columnSize="20rem"
                    gap="1rem"/>
            </f:layout>

            <!-- Asset Details -->
            <f:Card width="100%">
                <f:header>
                    <card:Header
                        title="Asset Details"
                        iconSrc="sap-icon://product"/>
                </f:header>

                <f:content>
                    <VBox class="sapUiSmallMargin">

                        <Label text="Asset Name"/>
                        <Text text="{assetName}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>
                        <Input value="{assetName}"
                            visible="{= ${ui>/editMode} !== 'Display' }"/>

                        <Label text="Asset Tag" class="sapUiSmallMarginTop"/>
                        <Text text="{assetTag}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>
                        <Input value="{assetTag}"
                            editable="{= ${ui>/editMode} === 'Editable' }"
                            visible="{= ${ui>/editMode} !== 'Display' }"/>

                        <Label text="Asset Type" 
                            class="sapUiSmallMarginTop" />
                            <Text
                                text="{assetType_typeCode}"
                                visible="{= ${ui>/editMode} === 'Display' }"/>

                            <ComboBox
                                width="100%"
                                selectedKey="{assetType_typeCode}"
                                visible="{= ${ui>/editMode} !== 'Display' }"
                                items="{/AssetTypes}">

                                <core:ListItem
                                    key="{typeCode}"
                                    text="{typeName}"
                                    additionalText="{typeCode}"/>

                            </ComboBox>

                        <!-- <Label text="Asset Type" class="sapUiSmallMarginTop"/> -->
                        <Text text="{assetType/typeName}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>

                        <Label text="Serial Number" class="sapUiSmallMarginTop"/>
                        <Text text="{serialNumber}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>
                        <Input value="{serialNumber}"
                            visible="{= ${ui>/editMode} !== 'Display' }"/>

                    </VBox>
                </f:content>
            </f:Card>

            <!-- Status and Location -->
            <f:Card width="100%">
                <f:header>
                    <card:Header
                        title="Status &amp; Location"
                        iconSrc="sap-icon://map"/>
                </f:header>

                <f:content>
                    <VBox class="sapUiSmallMargin">

                        <Label text="Status"/>
                        <ObjectStatus
                            text="{status}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>

                        <Select
                            selectedKey="{status}"
                            visible="{= ${ui>/editMode} !== 'Display' }"
                            width="100%">
                            <core:Item key="AVAILABLE" text="Available"/>
                            <core:Item key="ALLOCATED" text="Allocated"/>
                            <core:Item key="MAINTENANCE" text="Maintenance"/>
                            <core:Item key="RETIRED" text="Retired"/>
                        </Select>

                        <Label text="Condition" class="sapUiSmallMarginTop"/>
                        <ObjectStatus
                            text="{condition}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>

                        <Select
                            selectedKey="{condition}"
                            visible="{= ${ui>/editMode} !== 'Display' }"
                            width="100%">
                            <core:Item key="NEW" text="New"/>
                            <core:Item key="GOOD" text="Good"/>
                            <core:Item key="FAIR" text="Fair"/>
                            <core:Item key="DAMAGED" text="Damaged"/>
                        </Select>

                        <Label text="Location" class="sapUiSmallMarginTop"/>
                        <Text text="{location}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>
                        <Input value="{location}"
                            visible="{= ${ui>/editMode} !== 'Display' }"/>

                    </VBox>
                </f:content>
            </f:Card>

            <!-- Purchase Information -->
            <f:Card width="100%">
                <f:header>
                    <card:Header
                        title="Purchase Information"
                        iconSrc="sap-icon://money-bills"/>
                </f:header>

                <f:content>
                    <VBox class="sapUiSmallMargin">

                        <Label text="Purchase Cost"/>
                        <ObjectNumber
                            number="{purchaseCost}"
                            unit="INR"
                            visible="{= ${ui>/editMode} === 'Display' }"/>

                        <Input
                            value="{purchaseCost}"
                            type="Number"
                            visible="{= ${ui>/editMode} !== 'Display' }"/>

                        <Label text="Purchase Date" class="sapUiSmallMarginTop"/>
                        <Text text="{purchaseDate}"
                            visible="{= ${ui>/editMode} === 'Display' }"/>

                        <DatePicker
                            value="{purchaseDate}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd-MM-yyyy"
                            visible="{= ${ui>/editMode} !== 'Display' }"/>

                    </VBox>
                </f:content>
            </f:Card>

        </f:GridContainer>
    </VBox>
</core:FragmentDefinition>
