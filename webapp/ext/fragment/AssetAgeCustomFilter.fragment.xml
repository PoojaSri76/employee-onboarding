<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
        <ComboBox
            id="AssetCustomFilter"
            width="100%"
            core:require="{handler: 'assetmanagementanalytical/ext/fragment/AssetAgeCustomFilter'}"
            selectedKey="{path: 'filterValues>', type: 'sap.fe.macros.filter.type.Value', formatOptions: { operator: 'assetmanagementanalytical.ext.fragment.AssetAgeCustomFilter.filterItems' }}"
        >
            <items>
                <core:Item key="ALL" text="All Assets"/>
                <core:Item key="NEW" text="Less than 1 Year"/>
                <core:Item key="MID" text="1–3 Years"/>
                <core:Item key="OLD" text="More than 3 Years"/>
            </items>
        </ComboBox>
</core:FragmentDefinition>
